def cmd_shortcut(args):
    apply_macro(args.src, args.chord, dry_run=args.dry_run, assume_yes=args.yes)


def cmd_listen(args):
    info = device_info()
    banner(info)
    print("\nListening… press keys on the keyboard (Ctrl-C to stop).")
    print("  %-16s %-6s %s" % ("KEY", "CODE", "EVENT"))

    def on_event(prefix, code, name):
        kind = {"+": "press", "d": "press", "-": "release", "u": "release"}.get(prefix, prefix)
        print("  %-16s 0x%02X   %s" % (name, code, kind))
        return False

    try:
        stream_events(on_event)
    except KeyboardInterrupt:
        pass
    print("\nstopped.")


def cmd_show(args):
    info = device_info()
    banner(info)
    scb = read_device_config()
    if scb is None:
        print("\n  (converter has no config yet)")
        return
    print("\n  Current configuration")
    print("  " + "-" * 40)
    for line in disassemble(scb).rstrip().splitlines():
        if line.lstrip().startswith("#"):
            continue
        print("    " + line)
    print("  " + "-" * 40)


def cmd_info(args):
    out = run([tool("sctool"), "info"], check=False)
    print(out.rstrip())
    if "No devices found" in out:
        sys.exit(1)


def cmd_keys(args):
    term = (args.pattern or "").upper()
    names = sorted(n for n in KNOWN if not n.startswith("FAKE_") and term in n)
    for n in names:
        lab = LABELS.get(n, "")
        print("%-22s 0x%02X  %s" % (n, CODES[n], lab))
    print("\n%d key names." % len(names))


def cmd_read(args):
    scb = read_device_config()
    if scb is None:
        raise ToolError("converter has no config to read.")
    with open(args.file, "wb") as fh:
        fh.write(scb)
    print("wrote %s (%d bytes)" % (args.file, len(scb)))


def cmd_restore(args):
    with open(args.file, "rb") as fh:
        scb = fh.read()
    if not scb.startswith(b"SC"):
        raise ToolError("%s is not a Soarer's Converter .scb file." % args.file)
    print("restoring %d bytes from %s" % (len(scb), args.file))
    if not args.yes and not confirm("  Overwrite the converter config? [y/N] "):
        print("  aborted.")
        return
    cur = read_device_config()
    if cur is not None:
        print("  backup: %s" % backup(cur))
    write_device_config(scb)
    print("  restored.")


