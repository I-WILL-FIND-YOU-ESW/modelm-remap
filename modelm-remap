def confirm(prompt):
    try:
        return input(prompt).strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def banner(info):
    print("%s  ·  Soarer's Converter" % APP)
    print("  adapter  Soarer's Keyboard Converter  (USB %s)" % VID_PID)
    print("  firmware %s   EEPROM %s (%s free)" % (
        info.get("Code Version", "?"),
        info.get("EEPROM Size", "?"),
        info.get("EEPROM Free", "?")))


def show_menu():
    idx = 0
    index = {}
    for title, names in MENU_GROUPS:
        print("\n  %s" % title)
        for name in names:
            idx += 1
            index[str(idx)] = name
            lab = LABELS.get(name)
            if lab:
                print("    %3d  %-14s %s" % (idx, name, lab))
            else:
                print("    %3d  %s" % (idx, name))
    print("\n    letters, digits and symbols: just type them (A, 1, MINUS, LEFT_BRACE, ...)")
    print("    type a name directly, or '?' to search, or 'q' to quit")
    return index


def choose_target(src):
    index = show_menu()
    while True:
        try:
            ans = input("\n  What should %s become? > " % src).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            raise ToolError("aborted.")
        if not ans:
            continue
        if ans.lower() in ("q", "quit"):
            raise ToolError("aborted.")
        if ans == "?" or ans.lower() == "search":
            term = input("  search key names: ").strip().upper()
            matches = sorted(n for n in KNOWN if term in n)
            if not matches:
                print("  no match.")
                continue
            print("  " + ", ".join(matches))
            continue
        if ans in index:
            return index[ans]
        try:
            return resolve_name(ans)
        except ToolError as exc:
            print("  %s" % exc)


def choose_shortcut(src):
    print("\n  Shortcuts")
    index, n = {}, 0
    for name, spec in SHORTCUTS.items():
        n += 1
        index[str(n)] = name
        print("    %3d  %-14s %s" % (n, spec["chord"], spec["label"]))
    print("    or type a chord directly, e.g. CMD+SHIFT+4")
    while True:
        try:
            ans = input("\n  What shortcut should %s send? > " % src).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            raise ToolError("aborted.")
        if not ans:
            continue
        if ans.lower() in ("q", "quit"):
            raise ToolError("aborted.")
        if ans in index:
            return index[ans]
        try:
            resolve_shortcut(ans)
            return ans
        except ToolError as exc:
            print("  %s" % exc)


def capture_source(args):
    """Capture the key to act on (or take it from --from)."""
    if args.src:
        src = resolve_name(args.src)
        code = next((c for n, c in KEY_CODES if n == src), None)
        print("  using key from --from: %s" % src)
    else:
        src, code = capture_key(timeout=args.timeout)
        print("  \u2714 Detected: %s  (%s, code 0x%02X)" % (src, label(src), code))
    if src == "UNASSIGNED":
        raise ToolError("the converter reported UNASSIGNED for that key; try again.")
    return src


