def cmd_wizard(args):
    info = device_info()
    banner(info)
    print("\nSTEP 1 — Press the key you want to remap.")
    print("  Press it on the IBM Model M now (Ctrl-C to abort)…\n")
    if args.src:
        src = resolve_name(args.src)
        code = next((c for n, c in KEY_CODES if n == src), None)
        print("  using key from --from: %s" % src)
    else:
        src, code = capture_key(timeout=args.timeout)
        print("  \u2714 Detected: %s  (%s, code 0x%02X)" % (src, label(src), code))
    if src == "UNASSIGNED":
        raise ToolError("the converter reported UNASSIGNED for that key; try again.")
    print("\nSTEP 2 — What should %s do?" % src)
    dst = resolve_name(args.to) if args.to else choose_target(src)
    apply_remap(src, dst, dry_run=args.dry_run, assume_yes=args.yes)


def cmd_set(args):
    apply_remap(args.src, args.to, dry_run=args.dry_run, assume_yes=args.yes)


def cmd_macro(args):
    info = device_info()
    banner(info)
    print("\nSTEP 1 — Press the key that should send the shortcut.")
    print("  Press it on the IBM Model M now (Ctrl-C to abort)…\n")
    src = capture_source(args)
    print("\nSTEP 2 — Which shortcut?")
    shortcut = args.to if args.to else choose_shortcut(src)
    apply_macro(src, shortcut, dry_run=args.dry_run, assume_yes=args.yes)


def run_named_shortcut(name, args, prompt):
    info = device_info()
    banner(info)
    print(prompt)
    src = capture_source(args)
    apply_macro(src, name, dry_run=args.dry_run, assume_yes=args.yes)


def cmd_screenshot(args):
    run_named_shortcut(
        "SCREENSHOT", args,
        "\nPress the key that should take a region screenshot (⌘⇧4).\n"
        "  Press it on the IBM Model M now (Ctrl-C to abort)…\n")


def cmd_copy(args):
