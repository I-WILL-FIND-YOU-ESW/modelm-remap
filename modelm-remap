def build_parser():
    p = argparse.ArgumentParser(
        prog=APP,
        description="Remap keys on an IBM Model M through a Soarer's Converter.",
        epilog="With no command, the interactive wizard runs: press a key, then pick "
               "what it becomes (Command / Option / ... first).")
    p.add_argument("--bin-dir", help="directory holding scas/scdis/sctool")
    p.add_argument("--dry-run", action="store_true",
                   help="show the result without writing to the converter")
    p.add_argument("--yes", "-y", action="store_true", help="skip confirmation")
    p.add_argument("--from", dest="src", help="source key (skip key capture)")
    p.add_argument("--to", help="target key (skip the menu)")
    p.add_argument("--timeout", type=int, default=60, help="key-capture timeout in seconds")
    p.set_defaults(func=cmd_wizard)

    sub = p.add_subparsers(dest="cmd", metavar="command")

    def add_common(sp):
        sp.add_argument("--dry-run", action="store_true",
                        help="show the result without writing to the converter")
        sp.add_argument("--yes", "-y", action="store_true", help="skip confirmation")

    w = sub.add_parser("wizard", help="interactive: press a key, choose what it becomes")
    add_common(w)
    w.add_argument("--from", dest="src", help="skip capture and use this source key")
    w.add_argument("--to", help="skip the menu and use this target key")
    w.add_argument("--timeout", type=int, default=60, help="capture timeout in seconds")
    w.set_defaults(func=cmd_wizard)

    s = sub.add_parser("set", help="remap FROM to TO non-interactively")
    add_common(s)
    s.add_argument("src")
    s.add_argument("to")
    s.set_defaults(func=cmd_set)

    mc = sub.add_parser("macro", help="press a key -> send a shortcut (macro)")
    add_common(mc)
    mc.add_argument("--from", dest="src", help="skip capture and use this trigger key")
    mc.add_argument("--to", help="shortcut name or chord, e.g. SCREENSHOT or CMD+SHIFT+4")
    mc.add_argument("--timeout", type=int, default=60, help="capture timeout in seconds")
    mc.set_defaults(func=cmd_macro)

    def add_capture(name, help, handler):
        sp = sub.add_parser(name, help=help)
        add_common(sp)
        sp.add_argument("--from", dest="src", help="skip capture and use this trigger key")
        sp.add_argument("--timeout", type=int, default=60, help="capture timeout in seconds")
        sp.set_defaults(func=handler)

    add_capture("screenshot", "press a key -> take a region screenshot (Cmd+Shift+4)",
                cmd_screenshot)
    add_capture("copy", "press a key -> copy (Cmd+C)", cmd_copy)
    add_capture("paste", "press a key -> paste (Cmd+V)", cmd_paste)
    add_capture("select-all", "press a key -> select all (Cmd+A)", cmd_select_all)

    sh2 = sub.add_parser("shortcut", help="map a trigger key to a chord non-interactively")
    add_common(sh2)
    sh2.add_argument("src")
    sh2.add_argument("chord")
    sh2.set_defaults(func=cmd_shortcut)

    l = sub.add_parser("listen", help="print keys as you press them")
    l.set_defaults(func=cmd_listen)

    sh = sub.add_parser("show", help="show the config stored in the converter")
    sh.set_defaults(func=cmd_show)

    i = sub.add_parser("info", help="show firmware / EEPROM info")
    i.set_defaults(func=cmd_info)

    k = sub.add_parser("keys", help="list valid key names")
    k.add_argument("pattern", nargs="?", help="substring filter")
    k.set_defaults(func=cmd_keys)

    r = sub.add_parser("read", help="save the converter config to a file")
    r.add_argument("file")
    r.set_defaults(func=cmd_read)

    rs = sub.add_parser("restore", help="write a saved .scb config back")
    rs.add_argument("file")
    rs.add_argument("--yes", "-y", action="store_true")
    rs.set_defaults(func=cmd_restore)

    return p


def main(argv=None):
    global BINDIR
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass
    parser = build_parser()
    argv = list(sys.argv[1:] if argv is None else argv)
    args = parser.parse_args(argv)
    try:
        BINDIR = args.bin_dir or find_bindir()
        return args.func(args)
    except ToolError as exc:
        print("\n%s: %s" % (APP, exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main())
