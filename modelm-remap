class ToolError(Exception):
    pass


def find_bindir():
    env = os.environ.get("MODELM_REMAP_BIN")
    cands = [env, os.path.join(HERE, "vendor", "bin")] if env else [os.path.join(HERE, "vendor", "bin")]
    for d in cands:
        if d and all(os.path.exists(os.path.join(d, t)) for t in ("scas", "scdis", "sctool")):
            return d
    if all(shutil.which(t) for t in ("scas", "scdis", "sctool")):
        return None  # use PATH
    raise ToolError(
        "the Soarer's Converter tools are missing.\n"
        "Build them once with:  %s/build.sh" % HERE
    )


BINDIR = None


def tool(name):
    return name if BINDIR is None else os.path.join(BINDIR, name)


def run(cmd, check=True):
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          universal_newlines=True)
    if check and proc.returncode != 0:
        raise ToolError("`%s` failed:\n%s" % (" ".join(cmd), proc.stdout.strip()))
    return proc.stdout


def device_info():
    out = run([tool("sctool"), "info"], check=False)
    if "No devices found" in out or "Protocol Version" not in out:
        raise ToolError(
            "no Soarer's Converter found (USB %s).\n"
            "Check the adapter is plugged in and the keyboard cable is seated." % VID_PID)
    info = {}
    for line in out.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            info[k.strip()] = v.strip()
    return info


def _tmpdir():
    return tempfile.mkdtemp(prefix="modelm-remap.")


def read_device_config():
    """Return the raw .scb bytes currently in the converter, or None."""
    d = _tmpdir()
    path = os.path.join(d, "current.scb")
    out = run([tool("sctool"), "read", path], check=False)
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        if "No devices found" in out:
            raise ToolError("no Soarer's Converter found.")
        return None
    with open(path, "rb") as fh:
        return fh.read()


def disassemble(scb_bytes):
    d = _tmpdir()
    scb = os.path.join(d, "in.scb")
    sc = os.path.join(d, "out.sc")
    with open(scb, "wb") as fh:
        fh.write(scb_bytes)
    run([tool("scdis"), scb, sc])
    with open(sc) as fh:
        return fh.read()


def assemble(sc_text):
    d = _tmpdir()
    sc = os.path.join(d, "in.sc")
    scb = os.path.join(d, "out.scb")
    with open(sc, "w") as fh:
        fh.write(sc_text)
    out = run([tool("scas"), sc, scb], check=False)
    if not os.path.exists(scb):
        raise ToolError("could not assemble the config:\n%s" % out.strip())
    with open(scb, "rb") as fh:
        return fh.read()


def write_device_config(scb_bytes):
    d = _tmpdir()
    path = os.path.join(d, "new.scb")
    with open(path, "wb") as fh:
        fh.write(scb_bytes)
    out = run([tool("sctool"), "write", path], check=False)
    if "Transfer complete" not in out:
        raise ToolError("the converter rejected the write:\n%s" % out.strip())
    return out


def backup(scb_bytes):
    os.makedirs(BACKUP_DIR, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    scb = os.path.join(BACKUP_DIR, stamp + ".scb")
    with open(scb, "wb") as fh:
        fh.write(scb_bytes)
    try:
        with open(os.path.join(BACKUP_DIR, stamp + ".sc"), "w") as fh:
            fh.write(disassemble(scb_bytes))
    except ToolError:
        pass
    return scb


# --------------------------------------------------------------------------- #
# listen: read key events from the converter's diagnostic interface
# --------------------------------------------------------------------------- #

# Output looks like:  r62 +93 (LANG_4) d93 (LANG_4) rE2 -93 (LANG_4) u93 (LANG_4)
# '+' is the key-press event; '-' is release (see Soarer's docs/config.html).
EVENT_RE = re.compile(rb"([+\-du])([0-9A-Fa-f]{2})\s*\(([A-Z0-9_]+)\)")


def stream_events(on_event, timeout=None):
    """Run `sctool listen` and call on_event(prefix, code, name).

    on_event returns True to stop. Returns when stopped, when timeout expires,
    or when the stream ends.
    """
    proc = subprocess.Popen([tool("sctool"), "listen"],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    fd = proc.stdout.fileno()
    buf = b""
    start = time.time()
    try:
        while True:
            if timeout is not None and time.time() - start > timeout:
                return
            ready, _, _ = select.select([fd], [], [], 0.25)
            if not ready:
                continue
            chunk = os.read(fd, 4096)
            if not chunk:
                return
            buf += chunk
            while True:
                m = EVENT_RE.search(buf)
                if not m:
                    if len(buf) > 16:
                        buf = buf[-16:]
                    break
                prefix = m.group(1).decode()
                code = int(m.group(2), 16)
                name = m.group(3).decode()
                buf = buf[m.end():]
                if on_event(prefix, code, name):
                    return
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        drain_stdin()


def drain_stdin():
    """Keypresses typed while listening also land in the tty input queue."""
    try:
        import termios
        termios.tcflush(sys.stdin, termios.TCIFLUSH)
    except Exception:
        pass


def capture_key(timeout=60):
    """Wait for one physical key press; return (name, code)."""
    hit = {}

    def on_event(prefix, code, name):
        if prefix in ("+", "d"):
            hit["name"], hit["code"] = name, code
            return True
        return False

    stream_events(on_event, timeout=timeout)
    if not hit:
        raise ToolError("no key press detected (timed out).")
    return hit["name"], hit["code"]


# --------------------------------------------------------------------------- #
# Config editing
# --------------------------------------------------------------------------- #

def merge_remap(sc_text, src, dst):
    """Return sc_text with `src` remapped to `dst` in the first remapblock."""
    lines = [l for l in sc_text.splitlines()
             if l.strip() and not l.lstrip().startswith("#")]
    new_line = "\t%s %s" % (src, dst)

    start = next((i for i, l in enumerate(lines) if l.strip().lower() == "remapblock"), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines += ["remapblock", "layer 0", new_line, "endblock"]
        return "\n".join(lines) + "\n"

    end = next((i for i in range(start + 1, len(lines))
                if lines[i].strip().lower() == "endblock"), len(lines))
    kept = [l for l in lines[start + 1:end]
            if not (len(l.split()) >= 2 and l.split()[0].upper() == src.upper())]
    kept.append(new_line)
    lines = lines[:start + 1] + kept + lines[end:]
    return "\n".join(lines) + "\n"


def _drop_remap(lines, src):
    """Remove any `src -> ...` entry from the first remapblock."""
    start = next((i for i, l in enumerate(lines) if l.strip().lower() == "remapblock"), None)
    if start is None:
        return lines
    end = next((i for i in range(start + 1, len(lines))
                if lines[i].strip().lower() == "endblock"), len(lines))
    kept = [l for l in lines[start + 1:end]
            if not (len(l.split()) >= 2 and l.split()[0].upper() == src.upper())]
    return lines[:start + 1] + kept + lines[end:]


def merge_macro(sc_text, key, step_lines):
    """Return sc_text with a macro for `key` added (replacing any existing one)."""
    lines = [l for l in sc_text.splitlines()
             if l.strip() and not l.lstrip().startswith("#")]
    key = key.upper()
    lines = _drop_remap(lines, key)

    macro_def = ["\tmacro " + key] + ["\t\t" + s for s in step_lines] + ["\tendmacro"]

    start = next((i for i, l in enumerate(lines) if l.strip().lower() == "macroblock"), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines += ["macroblock"] + macro_def + ["endblock"]
        return "\n".join(lines) + "\n"

    end = next((i for i in range(start + 1, len(lines))
                if lines[i].strip().lower() == "endblock"), len(lines))
    body, i = [], start + 1
    while i < end:
        if lines[i].strip().lower().startswith("macro "):
            toks = lines[i].split()
            trigger = toks[1].upper() if len(toks) > 1 else ""
            block = [lines[i]]
            i += 1
            while i < end and lines[i].strip().lower() != "endmacro":
                block.append(lines[i])
                i += 1
            if i < end:
                block.append(lines[i])
                i += 1
            if trigger != key:
                body += block
        else:
            body.append(lines[i])
            i += 1
    body += macro_def
    lines = lines[:start + 1] + body + lines[end:]
    return "\n".join(lines) + "\n"


def apply_remap(src, dst, dry_run=False, assume_yes=False):
    info = device_info()
    src = resolve_name(src)
    dst = resolve_name(dst)

    if src == dst:
        raise ToolError("%s is already %s — nothing to do." % (src, dst))

    scb = read_device_config()
    if scb is None:
        sc_text = "remapblock\nlayer 0\n\t%s %s\nendblock\n" % (src, dst)
    else:
        sc_text = merge_remap(disassemble(scb), src, dst)

    new_scb = assemble(sc_text)

    print("\n  New configuration")
    print("  " + "-" * 40)
    for line in sc_text.rstrip().splitlines():
        print("    " + line)
    print("  " + "-" * 40)
    print("  %s  ->  %s" % (src, label(dst)))

    if dry_run:
        print("\n  --dry-run: nothing written to the converter.")
        return

    if not assume_yes and not confirm("\n  Write this to the converter? [y/N] "):
        print("  aborted.")
        return

    if scb is not None:
        path = backup(scb)
        print("  backup: %s" % path)

    write_device_config(new_scb)

    # verify
    check = read_device_config()
    ok = check is not None and check == new_scb
    print("  %s" % ("written and verified." if ok else "written (verification differed!)."))


def apply_macro(key, shortcut, dry_run=False, assume_yes=False):
    device_info()
    key = resolve_name(key)
    metas, target = resolve_shortcut(shortcut)
    step_lines = chord_to_macro_lines(metas, target)

    scb = read_device_config()
    if scb is None:
        sc_text = "\n".join(["macroblock", "\tmacro " + key] +
                            ["\t\t" + s for s in step_lines] +
                            ["\tendmacro", "endblock", ""])
    else:
        sc_text = merge_macro(disassemble(scb), key, step_lines)

    new_scb = assemble(sc_text)

    print("\n  New configuration")
    print("  " + "-" * 40)
    for line in sc_text.rstrip().splitlines():
        print("    " + line)
    print("  " + "-" * 40)
    print("  %s  ->  %s" % (key, " + ".join(metas + [target])))

    if dry_run:
        print("\n  --dry-run: nothing written to the converter.")
        return

    if not assume_yes and not confirm("\n  Write this to the converter? [y/N] "):
        print("  aborted.")
        return

    if scb is not None:
        print("  backup: %s" % backup(scb))

    write_device_config(new_scb)

    check = read_device_config()
    ok = check is not None and check == new_scb
    print("  %s" % ("written and verified." if ok else "written (verification differed!)."))


def resolve_name(name):
    """Normalise user input to a Soarer's Converter token."""
    up = name.strip().upper()
    if up in KNOWN:
        return up
    if up in ALIASES:
        return ALIASES[up]
    raise ToolError("unknown key %r. Run `%s keys` to see valid names." % (name, APP))


def label(name):
    return LABELS.get(name, name)


META_TOKENS = set(MODIFIERS.values()) | {"CTRL", "SHIFT", "ALT", "GUI", "ALL"}


def parse_chord(text):
    """Parse "CMD+SHIFT+4" into (["LGUI", "LSHIFT"], "4")."""
    parts = [p.strip() for p in text.split("+")]
    if len(parts) < 2 or any(not p for p in parts):
        raise ToolError("a shortcut needs modifiers and a key, e.g. CMD+SHIFT+4")
    *mods, key = parts
    metas = []
    for mod in mods:
        meta = MODIFIERS.get(mod.upper())
        if meta is None:
            raise ToolError("%r is not a modifier (try CMD, SHIFT, CTRL, OPT)." % mod)
        if meta not in metas:
            metas.append(meta)
    target = resolve_name(key)
    if target in META_TOKENS:
        raise ToolError("the last part of a shortcut must be an ordinary key.")
    return metas, target


def resolve_shortcut(name):
    up = name.strip().upper()
    if up in SHORTCUTS:
        name = SHORTCUTS[up]["chord"]
    return parse_chord(name)


def chord_to_macro_lines(metas, target):
    """Return the Soarer's macro steps that emit a shortcut when the key is pressed."""
    return [
        "PUSH_META ASSIGN_META " + " ".join(metas),
        "PRESS " + target,
        "POP_META",
    ]


